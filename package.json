{
  "name": "julia-ai",
  "productName": "Julia",
  "version": "4.4.0",
  "description": "Julia – persönlicher Assistent für den Windows-PC, mit Sprache, Bildschirmblick und Ampel-Freigaben.",
  "main": "src/main/main.js",
  "author": "MoinMornhart",
  "private": true,
  "license": "MIT",
  "scripts": {
    "start": "node scripts/start.js",
    "test": "node --test",
    "release": "node scripts/release.js",
    "installer": "electron-builder --win nsis --x64 --publish never",
    "webseite": "node scripts/webseite.js"
  },
  "build": {
    "appId": "io.github.moinmornhart.julia",
    "productName": "Julia AI",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "prompt/**/*",
      "package.json",
      "CHANGELOG.md",
      "!**/node_modules/minecraft-data/minecraft-data/data/bedrock/!(common)/**",
      "!**/node_modules/minecraft-data/doc/**"
    ],
    "asarUnpack": [
      "src/main/win/worker.ps1"
    ],
    "extraResources": [
      {
        "from": "vendor/whisper",
        "to": "whisper"
      }
    ],
    "electronLanguages": [
      "de",
      "en-US"
    ],
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableCookieEncryption": true,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "artifactName": "Julia-AI-Setup.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "Julia AI",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "MoinMornhart",
        "repo": "julia-ai-web",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "mineflayer": "4.39.0",
    "mineflayer-pathfinder": "2.4.5",
    "opusscript": "0.1.1",
    "prismarine-auth": "3.1.1",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "ws": "^8.21.3"
  },
  "engines": {
    "node": ">=20"
  }
}
